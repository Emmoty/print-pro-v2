# ==============================================================================
# CloudPrint Pro - Local LAN Print Agent Environment Configuration Template
# ==============================================================================

# Server Gateway URL (Production VPS or Local Kiosk)
SERVER_URL=https://your-domain.com
# SERVER_URL=http://localhost:3000

# Edge Agent Authentication
AGENT_ID=AGT-LAN-01
AGENT_TOKEN=YOUR_AGENT_SECRET_KEY

# Polling & Heartbeat Intervals (Milliseconds)
POLL_INTERVAL_MS=3000
HEARTBEAT_INTERVAL_MS=15000

# Target Hardware Printer Name Mappings (Match names in Windows/CUPS Printers)
# Leave as "Default" to route to the OS default printer automatically
PRINTER_A4_BW=Default
PRINTER_A4_COLOUR=Default
PRINTER_A3_BW=Default
PRINTER_A3_COLOUR=Default
DEFAULT_PRINTER=Default

# Spool Working Directory (Zero-Retention: Files shredded immediately after print)
AGENT_TEMP_DIR=./temp_spool
