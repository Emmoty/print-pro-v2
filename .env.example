# ==============================================================================
# CloudPrint Pro - Production Environment Configuration Template
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Security & Sessions
JWT_SECRET=change_this_to_a_cryptographically_secure_random_64_char_string_in_production
SESSION_SECRET=change_this_to_another_secure_random_string_for_cookie_encryption
TOKEN_EXPIRY_HOURS=12

# Trusted Origins (CORS) - Comma-separated
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://printpro.ke

# Safaricom Daraja M-Pesa API (Production / Sandbox)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=YOUR_DARAJA_CONSUMER_KEY
MPESA_CONSUMER_SECRET=YOUR_DARAJA_CONSUMER_SECRET
MPESA_PASSKEY=YOUR_DARAJA_ONLINE_PASSKEY
MPESA_BUSINESS_SHORTCODE=892100
MPESA_CALLBACK_SECRET=change_this_to_webhook_hmac_secret_key

# Print Agent Security
PRINT_AGENT_SECRET_KEY=change_this_to_agent_shared_secret_key

# Storage & Privacy (Zero Data Retention)
VAULT_STORAGE_PATH=./storage/vault
VAULT_RETENTION_TTL_MINUTES=15
MAX_FILE_SIZE_MB=50

# ==============================================================================
# Database Configuration (PostgreSQL on VPS)
# ==============================================================================
# Primary Connection String (Recommended for VPS / Docker / Cloud)
DATABASE_URL=postgresql://cloudprint_user:YOUR_VPS_POSTGRES_PASSWORD@YOUR_VPS_IP_OR_DOMAIN:5432/cloudprint?sslmode=prefer

# Alternative Individual Connection Parameters (If DATABASE_URL is not set)
PGHOST=YOUR_VPS_IP_OR_DOMAIN
PGPORT=5432
PGUSER=cloudprint_user
PGPASSWORD=YOUR_VPS_POSTGRES_PASSWORD
PGDATABASE=cloudprint
PGSSL=false
PG_POOL_MAX=20
PG_POOL_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000

# Local Fallback Data Path (Used if PostgreSQL is temporarily unreachable)
LOCAL_FALLBACK_DB_PATH=./data/cloudprint.json
